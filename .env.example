# Public site origin used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://24shoots-web.vercel.app

# Optional. Analytics loads only after the visitor accepts cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Without both values the contact form does not pretend to send:
# it opens the visitor's mail app addressed to info@24shoots.es.
# RESEND_FROM must be a sender verified in Resend.
RESEND_API_KEY=
RESEND_FROM=
